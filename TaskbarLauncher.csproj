<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TaskbarLauncher</RootNamespace>
    <AssemblyName>TaskbarLauncher</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>

    <!-- Einzelne, eigenständige .exe ohne separat installiertes .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Zusätzlich zum Win32-Ressourcen-Icon (ApplicationIcon) auch als
         eingebettete .NET-Ressource, damit die App zur Laufzeit die volle
         Auflösungsreihe laden kann (siehe MainForm.LoadAppIcon) - sonst
         liefert Icon.ExtractAssociatedIcon nur eine einzelne, kleine
         Auflösung, die für die Taskleiste hochskaliert und dadurch
         unscharf wird. -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

</Project>
